__pycache__/
*.pyc

# Research harness state and heavy run artifacts
.harness/
artifacts/
# ...and as a bare name, because artifacts/ is a symlink to /work/nvme once the home
# quota fills. A trailing slash matches directories only, so the symlink itself shows
# up as an untracked file -- enough to make the launcher refuse an E2 run.
artifacts

# run outputs / experiment artifacts
# outputs/ is ~23 GB of episodes (video, frames, codex rollouts) and belongs on the
# cluster filesystem; experiments/trajectories/ is the part of it that is in git.
outputs/
.venv/
logs/
results/
results_*/
slurm/
benchmark_*_only/
benchmark_find_test/
